        {
          "title": "具身智能（端侧部署，自进化闭环）",
          "english": "Embodied AI",
          "period": "2025–至今",
          "entries": [
            {
              "title": "OxyGen：多任务并行 VLA 推理加速",
              "role": "第一作者",
              "venue": "under review",
              "bullets": [
                "面向多任务（动作、语言）并行场景，提出跨任务、跨帧的统一 KV Cache 管理。",
                {
                  "text": "π0.5 在 RTX 4090 上至多加速 3.7×，同时达到 >200 tokens/s 语言吞吐、70 Hz 动作频率。",
                  "highlights": ["3.7×", ">200 tokens/s", "70 Hz"]
                }
              ],
              "paperRefs": [{ "id": "oxygen", "include": ["paper", "code", "page"] }]
            },
            {
              "title": "ActProbe：机器人策略早期失败检测",
              "role": "共同一作",
              "venue": "under review",
              "bullets": [
                "面向机器人策略模型的部署，设计轻量动作空间探针，在执行早期预测可能失败。",
                {
                  "text": "准确性与预警提前量的帕累托前沿面积提升 12.7%，未见任务的早期失败识别能力提升 9.0%。",
                  "highlights": ["12.7%", "9.0%"]
                }
              ],
              "paperRefs": [{ "id": "actprobe", "include": ["paper", "code", "page"] }]
            },
            {
              "title": "具身智能开源框架：Harness & Infra",
              "meta": "参与",
              "bullets": [
                {
                  "label": "Zetta ζ",
                  "text": "面向自进化物理智能的高效闭环具身 Harness，支持自主探索与持续提升。",
                  "refs": [
                    { "label": "代码", "href": "https://github.com/air-embodied-brain/Zetta-Embodiment", "githubRepository": "air-embodied-brain/Zetta-Embodiment" }
                  ]
                },
                {
                  "label": "Embodied.cpp",
                  "text": "面向异构机器人平台的可移植具身模型推理运行时。",
                  "refs": [
