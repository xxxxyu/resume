        {
          "title": "端侧智能（内存管理，算子优化）",
          "english": "On-Device AI",
          "period": "2022–2025",
          "entries": [
            {
              "title": "Vec-LUT：端侧低比特 LLM 并行推理加速",
              "role": "共同一作",
              "distinction": "Best Paper Award Runner-Up",
              "venue": "MobiSys 2026",
              "bullets": [
                "面向端侧超低比特 LLM 并行推理，提出向量查找表，加速混合精度矩阵乘法。",
                {
                  "text": "五款 x86 / ARM 设备上相比 llama.cpp 等框架至多加速 4.2×；能效（token/J）提升至多 2.1×。",
                  "highlights": ["4.2×", "2.1×"]
                }
              ],
              "paperRefs": [{ "id": "vec-lut", "include": ["paper", "code"] }]
            },
            {
              "title": "FlexNN：面向内存受限设备的高效自适应内存管理",
              "role": "第一作者",
              "venue": "MobiCom 2024",
              "bullets": [
                "面向内存受限设备，提出层切分、加载与计算联合规划，实现细粒度内存管理。",
                {
                  "text": "ResNet-152 在 Pixel 6 Pro 上内存降低 93.81%，延迟仅增 3.64%，重规划开销约 1 s。",
                  "highlights": ["93.81%", "3.64%", "1 s"]
                }
              ],
              "paperRefs": [{ "id": "flexnn", "include": ["paper", "code"] }]
            }
          ]
        }
